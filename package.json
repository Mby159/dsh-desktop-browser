{
  "name": "@deepseek-ai/dsh-desktop-browser",
  "description": "Host plugin: opens the dsh Web UI in a browser window with no address bar (--app mode)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/desktop-browser"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
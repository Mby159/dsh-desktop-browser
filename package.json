{
  "name": "@deepseek-ai/dsh-desktop-browser",
  "description": "Host plugin: opens the dsh Web UI in a browser window with no address bar (--app mode)",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mby159/dsh-desktop-browser.git"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist/**",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
